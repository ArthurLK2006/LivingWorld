#!/bin/sh
set -u
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
godot_bin=${GODOT_BIN:-/Applications/Godot 2.app/Contents/MacOS/Godot}
if [ ! -x "$godot_bin" ]; then
    echo "ERRO: Godot não encontrado; defina GODOT_BIN." >&2
    exit 1
fi
if [ "$#" -gt 0 ]; then
    exec "$godot_bin" --headless --path "$project_dir" -s res://addons/gut/gut_cmdln.gd "-gtest=$1" -gexit
fi
exec "$godot_bin" --headless --path "$project_dir" -s res://addons/gut/gut_cmdln.gd -gdir=res://tests/unit,res://tests/integration,res://tests/soak -ginclude_subdirs -gexit
