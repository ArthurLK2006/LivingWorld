#!/bin/sh
set -u
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"$project_dir/tools/check_prerequisites" || { echo "VERMELHO: pré-requisitos ausentes (veja a mensagem acima)." >&2; exit 1; }
output_file=$(mktemp "${TMPDIR:-/tmp}/livingworld-check.XXXXXX") || exit 1
trap 'rm -f "$output_file"' EXIT HUP INT TERM
status=0
"$project_dir/tools/check_architecture" || status=1
"$project_dir/tools/check_input_keys" || status=1
"$project_dir/tests/test_check_architecture.sh" || status=1
"$project_dir/tests/test_check_input_keys.sh" || status=1
"$project_dir/tests/test_check_prerequisites.sh" || status=1
"$project_dir/tools/check_gdscript_warnings" > "$output_file" 2>&1 || status=1
"$project_dir/tests/test_check_gdscript_warnings.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tools/validate_data" >> "$output_file" 2>&1 || status=1
"$project_dir/tests/test_validate_data.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tests/test_run_sim.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tests/test_filter_env_noise.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tests/test_compare_sp1_runs.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tests/test_main_scene.sh" >> "$output_file" 2>&1 || status=1
"$project_dir/tools/run_tests" "$@" >> "$output_file" 2>&1 || status=1
cat "$output_file"
if grep -E 'SCRIPT ERROR|Parse Error' "$output_file" >/dev/null; then
    echo "Falhou: erro de script ou análise detectado na saída."
    status=1
fi
if [ "$status" -ne 0 ]; then
    echo "VERMELHO: arquitetura, dados ou etapa de testes falhou."
    exit 1
fi
echo "VERDE: arquitetura, dados e etapa de testes aprovadas."
