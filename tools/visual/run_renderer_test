#!/bin/sh
# ARTE-F0: compara os renderizadores Compatibility (gl_compatibility) e Forward+ (forward_plus) com a cena isolada scenes/demo/renderer_test.tscn, em modo automático
# (3 predefinições de luz x 3 câmeras): grava PNGs e resumo.txt por renderer. ABRE UMA JANELA do Godot por cerca de 2 minutos (os dois renderers em sequência).
# Não altera o project.godot nem apaga nada. Uso: tools/visual/run_renderer_test [pasta-de-saída]  (padrão: uma pasta nova sob $TMPDIR).
# Variável opcional: GODOT_BIN (padrão: /Applications/Godot 2.app/Contents/MacOS/Godot).
set -u
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
godot_bin=${GODOT_BIN:-/Applications/Godot 2.app/Contents/MacOS/Godot}
if [ ! -x "$godot_bin" ]; then
    echo "ERRO: Godot não encontrado; defina GODOT_BIN." >&2
    exit 1
fi
out_dir=${1:-}
if [ -z "$out_dir" ]; then
    out_dir=$(mktemp -d "${TMPDIR:-/tmp}/lw-renderer-test.XXXXXX") || exit 1
fi
mkdir -p "$out_dir" || exit 1
echo "AVISO: este teste abre uma janela do Godot por cerca de 2 minutos (dois renderers, um depois do outro). Não mexa na janela."
echo "Saída em: $out_dir"
status=0
for renderer in gl_compatibility forward_plus; do
    echo "== $renderer =="
    if ! "$godot_bin" --path "$project_dir" --rendering-method "$renderer" --resolution 1280x720 --position 0,0 res://scenes/demo/renderer_test.tscn -- --auto "--out=$out_dir/$renderer"; then
        echo "FALHA: o Godot terminou com erro em $renderer." >&2
        status=1
    fi
done
echo "Resumos: $out_dir/gl_compatibility/resumo.txt e $out_dir/forward_plus/resumo.txt"
exit "$status"
