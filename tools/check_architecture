#!/bin/sh
set -u
root=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
failed=0
for dir in src/core src/data src/sim src/app src/persistence; do
    if [ ! -d "$root/$dir" ]; then echo "AUSENTE: $dir"; failed=1; fi
done
if [ "$failed" -ne 0 ]; then exit 1; fi
scan() {
    label=$1
    pattern=$2
    shift 2
    result=$(rg -n --no-heading --glob '*.gd' "$pattern" "$@" 2>&1)
    code=$?
    if [ "$code" -eq 0 ]; then
        printf '%s\n%s\n' "VIOLAÇÃO: $label" "$result"
        failed=1
    elif [ "$code" -ne 1 ]; then
        printf '%s\n%s\n' "ERRO: busca de $label falhou" "$result"
        failed=1
    fi
}
# Igual a `scan`, mas ignora as linhas ("arquivo:linha:texto") que casam com o ERE `allowed`. Serve às
# exceções declaradas, sempre estreitas (um arquivo e um uso), nunca a uma pasta inteira (LW-029A).
scan_allowing() {
    label=$1
    pattern=$2
    allowed=$3
    shift 3
    result=$(rg -n --no-heading --glob '*.gd' "$pattern" "$@" 2>&1)
    code=$?
    if [ "$code" -eq 0 ]; then
        result=$(printf '%s\n' "$result" | grep -vE "$allowed")
        if [ -n "$result" ]; then
            printf '%s\n%s\n' "VIOLAÇÃO: $label" "$result"
            failed=1
        fi
    elif [ "$code" -ne 1 ]; then
        printf '%s\n%s\n' "ERRO: busca de $label falhou" "$result"
        failed=1
    fi
}
# src/app fica de fora desta regra por enquanto: GameApp e SimulationHost estendem Node de propósito, e o
# comentário "sem Node" de simulation_runner.gd daria falso positivo (proposta de desvio da LW-029A).
scan 'simulação usa apresentação' '(^|[^A-Za-z0-9_])(Node[[:alnum:]_]*|Camera[[:alnum:]_]*|Control|get_node)([^A-Za-z0-9_]|$)|\$|res://scenes|src/presentation' "$root/src/sim" "$root/src/core" "$root/src/data" "$root/src/persistence"
# Funções globais e métodos de sorteio que não passam pelo WorldRng. `seed(`, instâncias criadas por
# ClassDB e fontes do sistema não são cobertos (busca de texto; ver docs/backlog.md).
scan 'aleatoriedade fora do core/rng' '(^|[^A-Za-z0-9_])(randf|randi|randomize|randf_range|randi_range|randfn|rand_from_seed)[[:space:]]*\(|\.(shuffle|pick_random)[[:space:]]*\(|RandomNumberGenerator\.new[[:space:]]*\(' --glob '!**/core/rng/**' "$root/src"
# O código da simulação mora em core, app, data, persistence e sim (src/sim só tem README por enquanto).
# Única exceção: o scheduler.gd lê o relógio do sistema para MEDIR microssegundos; isso nunca entra no estado.
scan_allowing 'tempo do sistema na simulação' '(Time|OS)\.get_' 'core/scheduler/scheduler\.gd:[0-9]+:.*Time\.get_ticks_usec' "$root/src/core" "$root/src/app" "$root/src/data" "$root/src/persistence" "$root/src/sim"
scan 'estado estático mutável' 'static[[:space:]]+var\b' "$root/src/core" "$root/src/app" "$root/src/data" "$root/src/persistence" "$root/src/sim"
# Só core (dono do relógio) e app (SimulationHost e SimulationRunner) avançam, pausam ou aceleram o
# relógio e mandam entregar eventos; módulos recebem o relógio só para LER (SimContext). Conta a CHAMADA
# (ponto antes do nome): declarar um método com o mesmo nome em outro módulo não é violação.
for dir in "$root"/src/*/; do
    case "$dir" in
        "$root"/src/core/ | "$root"/src/app/) continue ;;
    esac
    scan 'relógio ou barramento mexido fora de core e app' '\.(advance_step|set_paused|set_speed|dispatch)[[:space:]]*\(' "$dir"
done
for dir in "$root"/src/* "$root"/src/sim/* "$root"/src/presentation/*; do
    [ -d "$dir" ] || continue
    if [ ! -f "$dir/README.md" ]; then
        printf 'VIOLAÇÃO: contrato README ausente: %s/README.md (diretório: linha não aplicável)\n' "$dir"
        failed=1
    fi
done
# Regra 8 (arquitetura 27.3): todo evento (classe que estende SimEvent) consta na primeira coluna de docs/events.md.
catalog="$root/docs/events.md"
event_files=$(rg -l --glob '*.gd' 'extends[[:space:]]+SimEvent([^A-Za-z0-9_]|$)' "$root/src" 2>/dev/null)
event_report=$(for file in $event_files; do
    rg -n -o --no-heading 'class_name[[:space:]]+[A-Za-z0-9_]+|class[[:space:]]+[A-Za-z0-9_]+[[:space:]]+extends[[:space:]]+SimEvent|super\("[A-Za-z0-9_]+"\)' "$file" | while IFS=: read -r line text; do
        name=$(printf '%s' "$text" | sed -E 's/^class_name[[:space:]]+//; s/^class[[:space:]]+([A-Za-z0-9_]+).*/\1/; s/^super\("(.*)"\)/\1/')
        if ! grep -E "^\|[[:space:]]*\`?${name}\`?[[:space:]]*\|" "$catalog" >/dev/null 2>&1; then
            printf '%s:%s: evento "%s" não consta em docs/events.md\n' "$file" "$line" "$name"
        fi
    done
done)
if [ -n "$event_report" ]; then
    printf '%s\n%s\n' 'VIOLAÇÃO: evento fora do catálogo' "$event_report"
    failed=1
fi
# Regra 5 (arquitetura 27.3): os autoloads de project.godot só podem ser GameApp, SimulationHost, Debug e Settings.
project_file="$root/project.godot"
if [ -f "$project_file" ]; then
    autoload_report=$(awk '/^\[/ { in_autoload = ($0 == "[autoload]"); next } in_autoload && /^[A-Za-z0-9_]+=/ { split($0, parts, "="); name = parts[1]; if (name != "GameApp" && name != "SimulationHost" && name != "Debug" && name != "Settings") printf "%s:%d: autoload não permitido \"%s\"\n", FILENAME, NR, name }' "$project_file")
    if [ -n "$autoload_report" ]; then
        printf '%s\n%s\n' 'VIOLAÇÃO: autoload fora da lista permitida' "$autoload_report"
        failed=1
    fi
fi
# Regra 4 (arquitetura 27.3): import fora das camadas. Camadas por pasta (arquitetura 3.2): core 0, data 1,
# sim/world e sim/entities 2, sim/character, npc, economy e ecology 3, sim/factions, politics, military e
# combat 4, sim/events 5, persistence, bridge e app 6, presentation 7. `src/app` não está na tabela da
# arquitetura e conta como 6 (limitação); pastas sem camada (ai_text, net, tools) ficam de fora.
# (A) um arquivo não cita class_name de camada estritamente maior; (B) a apresentação não cita class_name de
# src/sim (fala com a simulação só pela ponte); (C) class_name declarada em uma pasta internal/ só é citada
# dentro do módulo dono (a pasta que contém internal/); (D) (LW-085a) a ponte (src/bridge) e as ferramentas (src/tools)
# só citam, de um módulo de src/sim que tenha pasta api/, as classes que moram nessa pasta api/ (AGENTS 5.1: "apenas a porta
# de entrada"); módulo sem api/ fica de fora, e src/app (raiz de composição) e src/persistence também. Citação = palavra inteira.
# Só nestas regras novas, linhas inteiras de comentário (começam com #) não contam; código com comentário no fim continua varrido.
# [LIM] Não vê classes internas (`class X:`) nem referências por caminho (`preload`); a regra D também não vê o tipo que volta de
# uma chamada sem nome nem o de uma variável com tipo inferido (`:=`).
gd_files=$(rg --files --glob '*.gd' "$root/src" 2>/dev/null | sort)
if [ -n "$gd_files" ]; then
    layer_report=$(awk -v pass=1 -v prefix="$root/src/" '
    function layer_of(path) {
        if (path ~ /^core\//) return 0
        if (path ~ /^data\//) return 1
        if (path ~ /^sim\/(world|entities)\//) return 2
        if (path ~ /^sim\/(character|npc|economy|ecology)\//) return 3
        if (path ~ /^sim\/(factions|politics|military|combat)\//) return 4
        if (path ~ /^sim\/events\//) return 5
        if (path ~ /^(persistence|bridge|app)\//) return 6
        if (path ~ /^presentation\//) return 7
        return -1
    }
    FNR == 1 {
        rel = substr(FILENAME, length(prefix) + 1)
        if (match(rel, /^sim\/[^\/]+\/api\//)) has_api[substr(rel, 1, RLENGTH - 4)] = 1
    }
    pass == 1 && /^class_name[[:space:]]+[A-Za-z0-9_]+/ {
        where[$2] = rel
        class_layer[$2] = layer_of(rel)
        cut = index(rel, "/internal/")
        if (cut > 0) owner[$2] = substr(rel, 1, cut)
        if (match(rel, /^sim\/[^\/]+\//)) module_of[$2] = substr(rel, 1, RLENGTH)
        if (rel ~ /^sim\/[^\/]+\/api\//) is_api[$2] = 1
        next
    }
    pass == 2 && $0 !~ /^[[:space:]]*#/ {
        count = split($0, tokens, /[^A-Za-z0-9_]+/)
        split("", seen)
        here = layer_of(rel)
        for (i = 1; i <= count; i++) {
            name = tokens[i]
            if (name == "" || !(name in where) || (name in seen) || where[name] == rel) continue
            seen[name] = 1
            if (here >= 0 && class_layer[name] > here)
                printf "A|%s:%d: \"%s\" (camada %d, src/%s) citada em arquivo de camada %d; esperado citar só camada menor ou igual.\n", FILENAME, FNR, name, class_layer[name], where[name], here
            if (rel ~ /^presentation\// && where[name] ~ /^sim\//)
                printf "B|%s:%d: \"%s\" (src/%s) citada pela apresentação; esperado falar com a simulação só pela ponte (bridge).\n", FILENAME, FNR, name, where[name]
            if ((name in owner) && index(rel, owner[name]) != 1)
                printf "C|%s:%d: \"%s\" (src/%s) é privada de src/%s; esperado citar só dentro do módulo.\n", FILENAME, FNR, name, where[name], owner[name]
            if (rel ~ /^(bridge|tools)\// && (name in module_of) && (module_of[name] in has_api) && !(name in is_api))
                printf "D|%s:%d: \"%s\" (src/%s) é interna de src/%s, que tem pasta api/; esperado citar só classes de src/%sapi/.\n", FILENAME, FNR, name, where[name], module_of[name], module_of[name]
        }
    }' $gd_files pass=2 $gd_files 2>&1)
    layer_code=$?
    if [ "$layer_code" -ne 0 ]; then
        printf '%s\n%s\n' 'ERRO: busca de import fora das camadas falhou' "$layer_report"
        failed=1
    else
        for layer_rule in A B C D; do
            case $layer_rule in
                A) layer_label='import de camada superior' ;;
                B) layer_label='apresentação cita classe da simulação' ;;
                C) layer_label='classe privada (internal/) citada fora do módulo' ;;
                D) layer_label='classe interna de módulo com api/ citada pela ponte ou por tools' ;;
            esac
            layer_part=$(printf '%s\n' "$layer_report" | sed -n "s/^$layer_rule|//p")
            if [ -n "$layer_part" ]; then
                printf '%s\n%s\n' "VIOLAÇÃO: $layer_label" "$layer_part"
                failed=1
            fi
        done
    fi
fi
if [ "$failed" -ne 0 ]; then exit 1; fi
echo 'Arquitetura: nove verificações aprovadas.'
