#!/bin/sh
# Mede o SP1 em build de RELEASE (sem depuração) no Mac, sem instalar nada no Godot nem no sistema.
#
# O QUE FAZ, em ordem:
#  1. Baixa os modelos de exportação OFICIAIS do Godot 4.7.2 (um arquivo de ~1,28 GB) para a
#     pasta de trabalho, confere o SHA-512 publicado pelo Godot, extrai SÓ o binário de release do
#     macOS (macos.zip, 123,6 MB, e dentro dele godot_macos_release.universal, 170 MB) e apaga o
#     download e o macos.zip (use KEEP_DOWNLOAD=1 para manter).
#  2. Cria na pasta de trabalho uma CÓPIA do projeto (git archive HEAD: só arquivos versionados),
#     com o spike SP1 como cena principal. O seu projeto não é alterado.
#  3. Exporta o pacote de recursos (.pck) com o Godot do editor (sem modelos de exportação).
#  4. Copia o binário de release para a pasta de execução, coloca o .pck ao lado com o mesmo nome
#     (é assim que um binário de release acha o jogo; os modelos de release não aceitam
#     --main-pack) e roda o SP1 RUNS vezes, comparando os picos.
# NADA é gravado em ~/Library, em configuração global do Godot, nem dentro do projeto.
#
# USO:   tests/soak/run_sp1_release [pasta_de_trabalho]        (padrão: $HOME/lw-release-probe)
# AJUSTES (variáveis de ambiente): GODOT_BIN, RUNS (2), DAYS (360), TOP (60), KEEP_DOWNLOAD (0).
# Para APAGAR tudo depois:  rm -rf "$HOME/lw-release-probe"
# Para testar sem baixar nada: LW_PROBE_TEMPLATE_BIN=/caminho/binario_de_release.
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
GODOT_BIN=${GODOT_BIN:-/Applications/Godot 2.app/Contents/MacOS/Godot}
WORK=${1:-$HOME/lw-release-probe}
RUNS=${RUNS:-2}
DAYS=${DAYS:-360}
TOP=${TOP:-60}
KEEP_DOWNLOAD=${KEEP_DOWNLOAD:-0}
GODOT_VERSION_PREFIX=4.7.2.stable
BASE_URL=https://github.com/godotengine/godot-builds/releases/download/4.7.2-stable
TEMPLATES_FILE=Godot_v4.7.2-stable_export_templates.tpz
MAIN_SCENE=res://tests/soak/sp1/sp1_main.tscn

say() { printf '\n== %s\n' "$1"; }
fail() { printf 'ERRO: %s\n' "$1" >&2; exit 1; }

[ -x "$GODOT_BIN" ] || fail "Godot não encontrado em '$GODOT_BIN'. Defina GODOT_BIN."
"$GODOT_BIN" --version | grep -q "^$GODOT_VERSION_PREFIX" || fail "Esta medição exige o Godot $GODOT_VERSION_PREFIX; o seu informa: $("$GODOT_BIN" --version)"
command -v git > /dev/null || fail "git não encontrado."
mkdir -p "$WORK"
case "$WORK" in "$PROJECT_DIR"|"$PROJECT_DIR"/*) fail "A pasta de trabalho precisa ficar FORA do projeto ($PROJECT_DIR).";; esac

sha512_of() {
    if command -v shasum > /dev/null; then shasum -a 512 "$1" | cut -d' ' -f1; else sha512sum "$1" | cut -d' ' -f1; fi
}

if [ -n "${LW_PROBE_TEMPLATE_BIN:-}" ]; then
    RELEASE_BIN=$LW_PROBE_TEMPLATE_BIN
    [ -x "$RELEASE_BIN" ] || fail "LW_PROBE_TEMPLATE_BIN não é executável: $RELEASE_BIN"
    say "1/4 Usando o binário de release informado: $RELEASE_BIN"
else
    command -v curl > /dev/null || fail "curl não encontrado."
    command -v unzip > /dev/null || fail "unzip não encontrado."
    TPZ=$WORK/$TEMPLATES_FILE
    say "1/4 Baixando os modelos de exportação oficiais (~1,28 GB) para $WORK"
    expected=$(curl -fsSL "$BASE_URL/SHA512-SUMS.txt" | grep " $TEMPLATES_FILE\$" | cut -d' ' -f1)
    [ -n "$expected" ] || fail "Não consegui obter o SHA-512 oficial do pacote."
    curl -fL -C - --progress-bar -o "$TPZ" "$BASE_URL/$TEMPLATES_FILE"
    [ "$(sha512_of "$TPZ")" = "$expected" ] || fail "SHA-512 do download não confere. Apague '$TPZ' e tente de novo."
    echo "SHA-512 conferido com o publicado pelo Godot."
    mkdir -p "$WORK/modelos" "$WORK/bin"
    unzip -o -j "$TPZ" "templates/macos.zip" -d "$WORK/modelos" > /dev/null
    inner=$(unzip -Z1 "$WORK/modelos/macos.zip" | grep '/MacOS/.*release' | head -1)
    [ -n "$inner" ] || fail "Não achei o binário de release dentro de macos.zip. Conteúdo: $(unzip -Z1 "$WORK/modelos/macos.zip" | head -20)"
    unzip -o -j "$WORK/modelos/macos.zip" "$inner" -d "$WORK/bin" > /dev/null
    RELEASE_BIN=$WORK/bin/$(basename "$inner")
    chmod +x "$RELEASE_BIN"
    xattr -d com.apple.quarantine "$RELEASE_BIN" 2> /dev/null || true
    # Binário arm64 precisa de assinatura; assinatura "ad hoc" só desta cópia extraída.
    command -v codesign > /dev/null && codesign --force --sign - "$RELEASE_BIN" 2> /dev/null || true
    [ "$KEEP_DOWNLOAD" = 1 ] || rm -f "$TPZ" "$WORK/modelos/macos.zip"
    echo "Binário de release: $RELEASE_BIN"
fi

say "2/4 Criando a cópia do projeto em $WORK/projeto (só arquivos versionados)"
rm -rf "$WORK/projeto"
mkdir -p "$WORK/projeto"
git -C "$PROJECT_DIR" archive HEAD | tar -x -C "$WORK/projeto"
sed "s|^run/main_scene=.*|run/main_scene=\"$MAIN_SCENE\"|" "$WORK/projeto/project.godot" > "$WORK/projeto/project.godot.novo"
mv "$WORK/projeto/project.godot.novo" "$WORK/projeto/project.godot"
cat > "$WORK/projeto/export_presets.cfg" <<'PRESET'
[preset.0]

name="Pacote"
platform="Linux"
runnable=false
export_filter="all_resources"
include_filter="*.json"
exclude_filter="addons/*"
export_path=""

[preset.0.options]

binary_format/embed_pck=false
PRESET

say "3/4 Exportando o pacote de recursos (.pck)"
"$GODOT_BIN" --headless --path "$WORK/projeto" --import > /dev/null 2>&1 || true
rm -f "$WORK/sp1.pck"
"$GODOT_BIN" --headless --path "$WORK/projeto" --export-pack "Pacote" "$WORK/sp1.pck" > "$WORK/exportacao.txt" 2>&1 || true
[ -s "$WORK/sp1.pck" ] || { cat "$WORK/exportacao.txt" >&2; fail "A exportação do pacote falhou (saída acima)."; }
echo "Pacote criado: $WORK/sp1.pck"

say "4/4 Rodando o SP1 em release ($RUNS vez(es), $DAYS dias, 1.000 NPCs, com controle)"
mkdir -p "$WORK/execucao"
cp "$RELEASE_BIN" "$WORK/execucao/sp1_release"
chmod +x "$WORK/execucao/sp1_release"
cp "$WORK/sp1.pck" "$WORK/execucao/sp1_release.pck"
command -v codesign > /dev/null && codesign --force --sign - "$WORK/execucao/sp1_release" 2> /dev/null || true
n=1
while [ "$n" -le "$RUNS" ]; do
    out=$WORK/release_run_$n.txt
    echo "--- execução $n (cerca de 2 minutos) -> $out"
    "$WORK/execucao/sp1_release" --headless -- --days "$DAYS" --top "$TOP" --control > "$out" 2>&1 || { cat "$out" >&2; fail "A execução $n terminou com erro (saída acima). Se a mensagem disser que não achou o jogo ou o pacote, me avise."; }
    grep -aE "^Motor:|Tempo por passo|^Passos acima|^Tempo total|^state_hash|^Engasgos|^Conclusão do controle" "$out"
    n=$((n + 1))
done
if [ "$RUNS" -ge 2 ]; then
    say "Comparação dos picos entre as execuções"
    "$PROJECT_DIR/tests/soak/compare_sp1_runs" "$WORK"/release_run_*.txt || true
fi
say "Pronto. Cole aqui o conteúdo de: $WORK/release_run_1.txt e release_run_2.txt"
echo "A linha 'Motor:' deve dizer 'build de depuração: não'. Para apagar tudo: rm -rf \"$WORK\""
