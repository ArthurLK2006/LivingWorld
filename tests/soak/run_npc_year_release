#!/bin/sh
# LW-084c: o soak longo (300 NPCs [HIP], padrão base ou stress) no binário de RELEASE, sem janela e sem baixar nada. Segue o método do run_game_release (cópia do projeto com a cena
# principal trocada SÓ NA CÓPIA, .pck exportado com o Godot do editor, binário de release com o .pck ao lado) e a régua da DEC-113 como PROPOSTA DE TRABALHO (a DEC-113 foi aprovada
# só para a LW-023): release, 3 execuções, laço de controle em cada uma. Reaproveita o binário de release já extraído em $HOME/lw-release-probe/bin; se faltar, rode antes
# tests/soak/run_game_release, que baixa os modelos oficiais do Godot 4.7.2 e confere o SHA-512. Grava só em $HOME/lw-release-probe/npc_year/<data e hora>; nada é apagado.
# USO:   tests/soak/run_npc_year_release [base|stress]       (o Mac precisa estar na tomada; a cópia sai do HEAD, ou seja, só o que está commitado)
# AJUSTES (variáveis de ambiente): DAYS (30), RUNS (3), CONTROL (1; 0 desliga o laço de controle), GODOT_BIN, PROBE ($HOME/lw-release-probe),
#          LW_PROBE_COPY=worktree (só para DESENVOLVER: copia a árvore de trabalho em vez do HEAD).
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
godot_bin=${GODOT_BIN:-/Applications/Godot 2.app/Contents/MacOS/Godot}
probe=${PROBE:-$HOME/lw-release-probe}
pattern=${1:-base}
days=${DAYS:-30}
runs=${RUNS:-3}
control=${CONTROL:-1}
main_scene=res://tests/soak/npc_year/npc_year_release_main.tscn
say() { printf '\n== %s\n' "$1"; }
fail() { printf 'ERRO: %s\n' "$1" >&2; exit 1; }
[ -x "$godot_bin" ] || fail "Godot não encontrado em '$godot_bin'. Defina GODOT_BIN."
"$godot_bin" --version | grep -q '^4.7.2.stable' || fail "Exige o Godot 4.7.2.stable; o seu informa: $("$godot_bin" --version)"
case "$pattern" in base|stress) ;; *) fail "padrão '$pattern' inválido; use base ou stress." ;; esac
release_bin=$(ls "$probe"/bin/*release* 2> /dev/null | head -1 || true)
[ -n "$release_bin" ] && [ -x "$release_bin" ] || fail "Binário de release não encontrado em $probe/bin. Rode antes tests/soak/run_game_release (ele baixa os modelos oficiais e confere o SHA-512)."
pmset -g batt | head -1
pmset -g batt | grep -q "AC Power" || fail "O Mac não está na tomada ('AC Power'): a medição com bateria não vale."
work=$probe/npc_year/$(date +%Y%m%d-%H%M%S)
case "$work" in "$project_dir"|"$project_dir"/*) fail "A pasta de trabalho precisa ficar FORA do projeto ($project_dir)." ;; esac
mkdir -p "$work/projeto" "$work/execucao"

say "1/3 Copiando o projeto para $work/projeto (a cena principal é trocada só na cópia)"
if [ "${LW_PROBE_COPY:-}" = worktree ]; then
    (cd "$project_dir" && git ls-files -co --exclude-standard | tar -T - -cf -) | tar -x -C "$work/projeto"
else
    git -C "$project_dir" archive HEAD | tar -x -C "$work/projeto"
fi
sed "s|^run/main_scene=.*|run/main_scene=\"$main_scene\"|" "$work/projeto/project.godot" > "$work/projeto/project.godot.novo"
mv "$work/projeto/project.godot.novo" "$work/projeto/project.godot"
cat > "$work/projeto/export_presets.cfg" <<'PRESET'
[preset.0]

name="Pacote"
platform="Linux"
runnable=false
export_filter="all_resources"
include_filter="*.json"
exclude_filter="addons/*"
export_path=""

[preset.0.options]

binary_format/embed_pck=false
PRESET

say "2/3 Exportando o pacote de recursos (.pck)"
"$godot_bin" --headless --path "$work/projeto" --import > /dev/null 2>&1 || true
"$godot_bin" --headless --path "$work/projeto" --export-pack "Pacote" "$work/game.pck" > "$work/exportacao.txt" 2>&1 || true
[ -s "$work/game.pck" ] || { cat "$work/exportacao.txt" >&2; fail "A exportação do pacote falhou (saída acima)."; }
cp "$release_bin" "$work/execucao/npc_year_release"
chmod +x "$work/execucao/npc_year_release"
cp "$work/game.pck" "$work/execucao/npc_year_release.pck"
command -v codesign > /dev/null && codesign --force --sign - "$work/execucao/npc_year_release" 2> /dev/null || true

say "3/3 Rodando em release ($runs vez(es), $days dias, padrão $pattern, 300 NPCs [HIP], controle: $control)"
flags=""
[ "$control" = 1 ] && flags="--control"
n=1
while [ "$n" -le "$runs" ]; do
    out=$work/saida_$n.txt
    echo "--- execução $n -> $out"
    echo "energia (antes): $(pmset -g batt | sed -n 1,2p | tr '\n' ' ')" > "$out"
    "$work/execucao/npc_year_release" --headless -- --days "$days" --pattern "$pattern" $flags >> "$out" 2>&1 || { cat "$out" >&2; fail "A execução $n terminou com erro (saída acima)."; }
    after=$(pmset -g batt | sed -n 1,2p | tr '\n' ' ')
    echo "energia (depois): $after" >> "$out"
    grep -aE '^Motor:|^dia |^soak:|^passo|^memória|^objetos|^corpos|^agendador|^controle|^conclusão|^energia' "$out" | cut -c1-600
    case "$after" in *"AC Power"*) ;; *) fail "O Mac saiu da tomada durante a execução $n: os números não valem; refaça." ;; esac
    n=$((n + 1))
done
hashes=$(grep -ah '^soak:' "$work"/saida_*.txt | sed 's/.*hash \([0-9a-f]*\).*/\1/' | sort -u | wc -l | tr -d ' ')
[ "$hashes" = 1 ] || fail "HASHES DIFERENTES entre as execuções ($hashes valores): veja $work/saida_*.txt."
say "Pronto. Hash idêntico nas $runs execuções. Saídas em $work/saida_*.txt"
